<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="2.0" 
                xmlns:html="http://www.w3.org/TR/REC-html40"
                xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
  <xsl:template match="/">
    <html lang="en">
      <head>
        <title>XML Sitemap - Galaxy Converter</title>
        <style>
          :root {
            --bg-dark: #0b0d19;
            --card-bg: rgba(20, 24, 48, 0.85);
            --accent-purple: #a855f7;
            --accent-cyan: #06b6d4;
            --text-bright: #f8fafc;
            --text-muted: #94a3b8;
          }
          body {
            background: radial-gradient(circle at 50% 10%, #1e1b4b 0%, #0f172a 50%, var(--bg-dark) 100%);
            color: var(--text-bright);
            font-family: 'Segoe UI', Roboto, sans-serif;
            margin: 0; padding: 40px 20px;
            min-height: 100vh; display: flex; flex-direction: column; align-items: center;
          }
          .container {
            max-width: 900px; width: 100%;
            background: var(--card-bg); backdrop-filter: blur(12px);
            border: 1px solid rgba(147, 51, 234, 0.3); border-radius: 16px;
            padding: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);
          }
          h1 {
            font-size: 2rem;
            background: linear-gradient(135deg, #fff, var(--accent-cyan), var(--accent-purple));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
          }
          p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 25px; line-height: 1.5; }
          .stats {
            display: inline-block; padding: 6px 14px;
            background: rgba(6, 182, 212, 0.15); border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan); border-radius: 20px; font-size: 0.85rem; margin-bottom: 20px;
          }
          table { width: 100%; border-collapse: collapse; margin-top: 10px; }
          th {
            text-align: left; padding: 12px 15px; color: var(--accent-cyan);
            border-bottom: 2px solid rgba(147, 51, 234, 0.4); font-size: 0.9rem; text-transform: uppercase;
          }
          td { padding: 14px 15px; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 0.9rem; }
          tr:hover { background: rgba(168, 85, 247, 0.08); }
          a { color: var(--accent-purple); text-decoration: none; word-break: break-all; font-weight: 500; }
          a:hover { color: var(--accent-cyan); text-decoration: underline; }
          .footer { margin-top: 30px; text-align: center; color: var(--text-muted); font-size: 0.8rem; }
        </style>
      </head>
      <body>
        <div class="container">
          <h1>🚀 Galaxy Converter XML Sitemap</h1>
          <p>This is a styled XML Sitemap used by search engines like Google, Bing, and Yahoo to index pages on Galaxy Converter.</p>
          <div class="stats">Total URLs in Sitemap: <xsl:value-of select="count(sitemap:urlset/sitemap:url)"/></div>
          
          <table>
            <thead>
              <tr>
                <th>URL Index</th>
                <th>Priority</th>
                <th>Change Freq</th>
                <th>Last Modified</th>
              </tr>
            </thead>
            <tbody>
              <xsl:for-each select="sitemap:urlset/sitemap:url">
                <tr>
                  <td><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
                  <td><xsl:value-of select="sitemap:priority"/></td>
                  <td><xsl:value-of select="sitemap:changefreq"/></td>
                  <td><xsl:value-of select="sitemap:lastmod"/></td>
                </tr>
              </xsl:for-each>
            </tbody>
          </table>
          <div class="footer">&copy; 2026 Galaxy Converter. Generated for Search Engines &amp; Users.</div>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
